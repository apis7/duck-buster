{
  "expo": {
    "name": "Duck Buster",
    "slug": "duck-buster",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "duckbuster",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.duckbuster.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Duck Buster uses the camera only to scan transfer codes from another phone."
      }
    },
    "android": {
      "package": "com.duckbuster.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "./plugins/with-long-path-cmake",
      "expo-status-bar",
      "expo-sqlite",
      "expo-audio",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Duck Buster uses the camera only to scan transfer codes from another phone.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (pulled in by Google Mobile Ads) builds its Room database by reflection.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.** { *; }\n-keep class androidx.room.** { *; }\n"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
